FROM node:22-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

FROM node:22-slim
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY package.json ./
ARG AGENT_ENTRYPOINT=dist/index.js
ENV AGENT_ENTRYPOINT=${AGENT_ENTRYPOINT}
EXPOSE 7378
CMD node ${AGENT_ENTRYPOINT}
