{
  "name": "Forge Data Ingestion",
  "description": "Fetches market data every 30 minutes from Pyth Oracle, Deribit, and CoinGlass. Stores aggregated data with timestamp indexing.",
  "trigger": {
    "type": "cron",
    "schedule": "*/30 * * * *",
    "timezone": "UTC"
  },
  "goal": "Ingest real-time market data for all supported assets (BTC, ETH, SOL, XAU, SPX, NVDA, TSLA, AAPL, GOOGL) from multiple data sources and store with timestamp indexing.",
  "steps": [
    {
      "id": "step-1-pyth-prices",
      "name": "Fetch Pyth Oracle Prices",
      "description": "Call Pyth Hermes API to get latest prices for all 9 supported assets.",
      "agentType": "rest-api",
      "config": {
        "method": "GET",
        "url": "https://hermes.pyth.network/v2/updates/price/latest",
        "params": {
          "ids[]": [
            "0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43",
            "0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace",
            "0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d"
          ]
        }
      },
      "output": "pyth_prices"
    },
    {
      "id": "step-2-deribit-data",
      "name": "Fetch Deribit Order Book and Funding",
      "description": "Call Deribit API for perpetual funding rates, order book snapshots, and OHLCV data for BTC, ETH, SOL.",
      "agentType": "rest-api",
      "config": {
        "requests": [
          {
            "method": "GET",
            "url": "https://www.deribit.com/api/v2/public/get_funding_rate_value",
            "params": { "instrument_name": "BTC-PERPETUAL", "start_timestamp": "{now-8h}", "end_timestamp": "{now}" }
          },
          {
            "method": "GET",
            "url": "https://www.deribit.com/api/v2/public/get_tradingview_chart_data",
            "params": { "instrument_name": "BTC-PERPETUAL", "resolution": "60", "start_timestamp": "{now-30d}", "end_timestamp": "{now}" }
          },
          {
            "method": "GET",
            "url": "https://www.deribit.com/api/v2/public/get_book_summary_by_currency",
            "params": { "currency": "BTC", "kind": "option" }
          }
        ]
      },
      "output": "deribit_data"
    },
    {
      "id": "step-3-coinglass-data",
      "name": "Fetch CoinGlass Liquidation and OI Data",
      "description": "Scrape/API CoinGlass for liquidation levels, open interest distribution, and long/short ratios.",
      "agentType": "rest-api",
      "config": {
        "requests": [
          {
            "method": "GET",
            "url": "https://open-api-v3.coinglass.com/api/futures/openInterest/chart",
            "params": { "symbol": "BTC", "interval": "1h" },
            "headers": { "coinglassSecret": "{COINGLASS_API_KEY}" }
          },
          {
            "method": "GET",
            "url": "https://open-api-v3.coinglass.com/api/futures/liquidation/chart",
            "params": { "symbol": "BTC" },
            "headers": { "coinglassSecret": "{COINGLASS_API_KEY}" }
          }
        ]
      },
      "output": "coinglass_data"
    },
    {
      "id": "step-4-store-data",
      "name": "Store Aggregated Market Data",
      "description": "Aggregate all fetched data into a MarketDataBundle per asset and store in workspace files with timestamp indexing.",
      "agentType": "code-executor",
      "input": ["pyth_prices", "deribit_data", "coinglass_data"],
      "config": {
        "action": "Upload aggregated JSON to workspace files as market-data/{asset}/{timestamp}.json"
      },
      "output": "ingestion_result"
    }
  ],
  "onComplete": {
    "trigger": "workflow:02-prediction-generation"
  }
}
