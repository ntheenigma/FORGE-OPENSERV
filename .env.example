# OpenServ Platform
OPENSERV_API_KEY=your_openserv_api_key
OPENAI_API_KEY=your_openai_api_key

# Agent Ports (each agent runs on its own port)
VOLATILITY_AGENT_PORT=7378
LIQUIDATION_AGENT_PORT=7379
SENTIMENT_AGENT_PORT=7380
PATTERN_AGENT_PORT=7381
SYNTHESIZER_AGENT_PORT=7382
API_SERVER_PORT=3000

# Market Data APIs
PYTH_HERMES_URL=https://hermes.pyth.network
DERIBIT_API_URL=https://www.deribit.com/api/v2
COINGLASS_API_KEY=your_coinglass_api_key
COINGLASS_API_URL=https://open-api-v3.coinglass.com

# Social / Sentiment
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# x402 Payment Configuration
X402_WALLET_ADDRESS=your_wallet_address
X402_SETTLEMENT_TOKEN=USDC
X402_NETWORK=base

# Agent Registry
AGENT_STAKE_AMOUNT_USD=50
MAX_AGENTS_SAME_ARCHITECTURE_PCT=30

# Scoring
CRPS_ROLLING_WINDOW_DAYS=10
BOTTOM_DEPRECATION_PCT=10
